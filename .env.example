# UrbanPulse environment configuration
# Copy to .env and adjust for your local setup.

# Kafka bootstrap servers (host-side scripts use external ports)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092

# Docker streaming-runner uses internal broker addresses
# KAFKA_BOOTSTRAP_SERVERS=kafka1:9092,kafka2:9092,kafka3:9092

# Flink connector JAR path (inside Docker streaming-runner)
FLINK_KAFKA_CONNECTOR_JAR=/opt/flink/lib/flink-sql-connector-kafka-3.0.1-1.18.jar

# Spark checkpoint and output locations (relative to project root)
SPARK_WARD_CHECKPOINT=checkpoints/ward_energy
SPARK_HEALTH_CHECKPOINT=checkpoints/health_advisories
WARD_ENERGY_PARQUET_OUTPUT=data/ward_energy_summary

# Logging
LOG_LEVEL=INFO
